# ModelArk credentials
ARK_API_KEY=your-byteplus-modelark-api-key
BYTEPLUS_ACCESS_KEY_ID=your-dedicated-iam-access-key-id
BYTEPLUS_SECRET_ACCESS_KEY=your-dedicated-iam-secret-access-key

# Google: Gemini Developer API (Omni; Veo only until 2026-10-22)
GEMINI_API_KEY=
# Google: Vertex AI (Veo 3.1 GA, Omni preview)
VERTEX_PROJECT=
# Service-account JSON; leave empty to use Application Default Credentials.
# Local launch configurations read the host path below; Docker Compose mounts
# ./secrets read-only and uses GOOGLE_CREDENTIALS_FILE (file name in ./secrets).
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CREDENTIALS_FILE=
GOOGLE_VEO_BACKEND=vertex
GOOGLE_VEO_LOCATION=us-central1
GOOGLE_OMNI_BACKEND=vertex
GOOGLE_OMNI_LOCATION=global

# Kling
KLING_API_KEY=
KLING_BASE_URL=https://api-singapore.klingai.com

# Signing secret for webhook_url notifications (whsec_<base64>)
WEBHOOK_SECRET=

# Public HTTPS URL used for reference uploads
PUBLIC_BASE_URL=https://seedance-proxy.example.com

# Verified person asset group used for Real-Human references
BYTEPLUS_ASSET_GROUP_ID=group-your-verified-person

# Shared secret between clients, the studio, and the proxy (at least 32 characters)
PROXY_API_KEY=replace-with-at-least-32-random-characters

# Single-user web studio
UI_USERNAME=seedance-admin
UI_PASSWORD=replace-with-a-private-studio-password
UI_SESSION_SECRET=replace-with-at-least-32-random-characters
