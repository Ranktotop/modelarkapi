ARK_API_KEY=your-byteplus-modelark-api-key
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
PROXY_API_KEY=choose-a-private-key-for-litellm
PUBLIC_BASE_URL=https://seedance-proxy.example.com
DEFAULT_MODEL=dreamina-seedance-2-0-fast-260128
DEFAULT_GENERATE_AUDIO=true
MEDIA_TTL_SECONDS=86400
MEDIA_CLEANUP_INTERVAL_SECONDS=900
MAX_UPLOAD_BYTES=209715200
MAX_UPSTREAM_CONNECTIONS=100
MAX_KEEPALIVE_CONNECTIONS=20
# Optional aliases, encoded as JSON:
MODEL_MAP={"seedance":"dreamina-seedance-2-0-fast-260128"}

# Single-user web studio
UI_PASSWORD=replace-with-a-private-studio-password
UI_SESSION_SECRET=replace-with-at-least-32-random-characters
# Only for a trusted local environment; leave false when using a password.
UI_AUTH_DISABLED=false
# Set true when the UI is served through HTTPS.
UI_COOKIE_SECURE=false
UI_JOB_TTL_SECONDS=86400
UI_CLEANUP_INTERVAL_SECONDS=900
UI_POLL_INTERVAL_SECONDS=10
UI_POLL_CONCURRENCY=20
UI_MAX_PROXY_CONNECTIONS=100
UI_SESSION_TTL_SECONDS=43200
