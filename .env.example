ARK_API_KEY=your-byteplus-modelark-api-key
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
PROXY_API_KEY=replace-with-at-least-32-random-characters
REQUIRE_PROXY_API_KEY=false
PUBLIC_BASE_URL=https://seedance-proxy.example.com
DEFAULT_MODEL=dreamina-seedance-2-0-fast-260128
DEFAULT_GENERATE_AUDIO=true
MEDIA_TTL_SECONDS=86400
MEDIA_CLEANUP_INTERVAL_SECONDS=900
MAX_UPLOAD_BYTES=209715200
MAX_UPSTREAM_CONNECTIONS=100
MAX_KEEPALIVE_CONNECTIONS=20
# Optional aliases, encoded as JSON:
MODEL_MAP={"seedance":"dreamina-seedance-2-0-fast-260128"}

# Automatic temporary Real-Human assets (AK/SK-authenticated Assets API)
BYTEPLUS_ACCESS_KEY_ID=your-dedicated-iam-access-key-id
BYTEPLUS_SECRET_ACCESS_KEY=your-dedicated-iam-secret-access-key
BYTEPLUS_ASSET_GROUP_ID=group-your-verified-person
BYTEPLUS_PROJECT_NAME=default
BYTEPLUS_ASSET_REGION=ap-southeast-1
BYTEPLUS_ASSET_ENDPOINT=https://ark.ap-southeast-1.byteplusapi.com
ASSET_JOB_DB=./data/proxy-jobs.db
ASSET_POLL_INTERVAL_SECONDS=5
ASSET_MAINTENANCE_INTERVAL_SECONDS=2
ASSET_MAX_PROCESSING_SECONDS=3600
ASSET_JOB_TTL_SECONDS=86400
ASSET_WORKER_CONCURRENCY=10
ASSET_CLEANUP_RETRIES=5
ASSET_ORPHAN_CLEANUP_INTERVAL_SECONDS=900
ASSET_ORPHAN_TTL_SECONDS=86400

# Single-user web studio
UI_USERNAME=seedance-admin
UI_PASSWORD=replace-with-a-private-studio-password
UI_SESSION_SECRET=replace-with-at-least-32-random-characters
# Only for a trusted local environment; leave false when using a password.
UI_AUTH_DISABLED=false
# Production default; only set false for trusted local HTTP development.
UI_COOKIE_SECURE=true
UI_JOB_TTL_SECONDS=86400
UI_CLEANUP_INTERVAL_SECONDS=900
UI_POLL_INTERVAL_SECONDS=10
UI_POLL_CONCURRENCY=20
UI_MAX_PROXY_CONNECTIONS=100
UI_SESSION_TTL_SECONDS=43200
UI_LOGIN_MAX_ATTEMPTS=5
UI_LOGIN_WINDOW_SECONDS=900
